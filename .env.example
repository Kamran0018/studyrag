# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env to version control.

SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Google AI Studio → https://aistudio.google.com/app/apikey
# Single key OR multiple comma-separated keys for Automatic Rate-Limit Failover & Pooling:
GOOGLE_API_KEY_1=your-primary-google-api-key
GOOGLE_API_KEY_2=your-secondary-google-api-key
GOOGLE_API_KEY=your-primary-google-api-key,your-secondary-google-api-key

GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
