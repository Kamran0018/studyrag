# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env to version control.

SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# LLM Provider
LLM_PROVIDER=groq

# Groq API Keys → https://console.groq.com/keys
# Ultra-fast inference with Multi-Key Failover & Load Pooling:
GROQ_API_KEY_1=your-primary-groq-api-key
GROQ_API_KEY_2=your-secondary-groq-api-key
GROQ_API_KEY=your-primary-groq-api-key
GROQ_CHAT_MODEL=openai/gpt-oss-120b

